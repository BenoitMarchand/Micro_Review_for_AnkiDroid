<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pill-shaped button in the review notification; the background and text color are set per button. -->
    <style name="NotificationAnswerButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Answer button of the home screen widget: four of them fit down to the widget's minimum width. -->
    <style name="WidgetAnswerButton" parent="NotificationAnswerButton">
        <item name="android:layout_margin">3dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
