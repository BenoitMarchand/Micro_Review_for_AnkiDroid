<?xml version="1.0" encoding="utf-8"?>
<!-- Question, then "Show answer"; once revealed: the answer and the answer buttons. After the session's answer,
     the message "Next card at your next unlock" replaces the buttons.
     A notification has a maximum height and can't scroll: the texts have a weight, so they give up height when
     it runs out, and the buttons always stay visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutExpanded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/textViewExpandedHeader"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:paddingVertical="8dp" />

    <FrameLayout
        android:id="@+id/answerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/notification_divider"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewContent"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:paddingVertical="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/answerButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/button1"
            style="@style/NotificationAnswerButton"
            android:background="@drawable/bg_pill_again"
            android:textColor="@color/again_button_text"
            android:text="@string/again" />

        <Button
            android:id="@+id/button2"
            style="@style/NotificationAnswerButton"
            android:background="@drawable/bg_pill_hard"
            android:textColor="@color/hard_button_text"
            android:text="@string/hard" />

        <Button
            android:id="@+id/button3"
            style="@style/NotificationAnswerButton"
            android:background="@drawable/bg_pill_good"
            android:textColor="@color/good_button_text"
            android:text="@string/good" />

        <Button
            android:id="@+id/button4"
            style="@style/NotificationAnswerButton"
            android:background="@drawable/bg_pill_easy"
            android:textColor="@color/easy_button_text"
            android:text="@string/easy" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewNextCard"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:text="@string/next_card_at_next_unlock"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonShowAnswer"
        style="@style/NotificationAnswerButton"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:background="@drawable/bg_pill_show_answer"
        android:textColor="@color/show_answer_button_text"
        android:text="@string/show_answer" />
</LinearLayout>
